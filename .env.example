# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/agentforce_roadmap
# For Heroku Postgres, use: postgres://username:password@host:5432/database

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Chat Configuration
MAX_CONTEXT_ITEMS=5
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4-turbo-preview

# vibewareauth — register at https://vibewareauth-admin-64156d094d72.herokuapp.com/my-apps/new
VIBEWAREAUTH_API_BASE=https://api.vibewareauth.com
VIBEWAREAUTH_APP_ID=
VIBEWAREAUTH_APP_SECRET=
VIBEWAREAUTH_ADMIN_URL=https://vibewareauth-admin-64156d094d72.herokuapp.com

# Public base URL (used for the SSO redirect_uri)
# Local dev: http://localhost:3000   Heroku: https://<your-app>.herokuapp.com
PUBLIC_BASE_URL=

# Passkey / WebAuthn — keep DISABLED unless you're in a Heroku Private Space
ENABLE_WEBAUTHN=false

# Emergency bypass (generate: node -e "console.log('bg_' + require('crypto').randomBytes(48).toString('base64url'))")
# Store the real value in 1Password, NOT in this file.
BREAK_GLASS_TOKEN=

# Optional: Slack webhook to alert on break-glass use
BREAK_GLASS_ALERT_WEBHOOK=

